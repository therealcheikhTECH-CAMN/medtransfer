# ==============================================================================
# MEDTRANSFER — Plateforme de gestion de l'historique médical et d'orientation des patients.
# Variables d'Environnement
# ==============================================================================

# Sécurité Django
DJANGO_SECRET_KEY=medtransfer-default-secret-key-medical-platform
DEBUG=True
MEDTRANSFER_ENV=staging
MEDTRANSFER_TEST_MODE=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Variables d'initialisation du compte administrateur général (Optionnel)
# À renseigner uniquement lors de l'exécution manuelle de bootstrap_initial_admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Base de Données PostgreSQL Centralisée
# Pour exécution locale directe ou Docker :
DB_NAME=medtransfer_db
DB_USER=medtransfer_user
DB_PASSWORD=medtransfer_pass2026
DB_HOST=localhost
DB_PORT=5432

# Option de repli pour développement/tests hors conteneur si PostgreSQL local n'est pas encore démarré
# Mettre à False pour forcer la connexion stricte à PostgreSQL
USE_SQLITE=True

# Intelligence Artificielle (OpenAI)
# Laisser vide pour activer le moteur local de synthèse structurée sans erreur
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend URL pour CORS et liens d'e-mail
FRONTEND_URL=http://localhost:5173

# Configuration E-mail / SMTP (Validation des comptes & Réinitialisation de mot de passe)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=votre-adresse@domaine.sn
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=MEDTRANSFER <no-reply@medtransfer.sn>
EMAIL_TIMEOUT=10
PASSWORD_RESET_TIMEOUT=3600
